# Build:
#   docker build --no-cache -t felipemunaro/ceemdan-model:torch -f Dockerfile_torch .
#
# CPU:
#   docker run --rm -it --entrypoint bash -v "${PWD}:/app" felipemunaro/ceemdan-model:torch
#   python3 -u run_france_torch.py
#
# Publicar no dockerhub:
#   docker push felipemunaro/ceemdan-model:torch

FROM python:3.10-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SETUPTOOLS_USE_DISTUTILS=stdlib \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    MPLCONFIGDIR=/tmp/matplotlib

WORKDIR /app

# Bibliotecas do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# Pip
RUN python -m pip install --no-cache-dir --upgrade pip==24.3.1

RUN python -m pip install --no-cache-dir --no-compile --no-deps \
    torch==2.2.2 \
    --index-url https://download.pytorch.org/whl/cpu

# Dependências científicas
RUN python -m pip install --no-cache-dir numpy==1.23.5
RUN python -m pip install --no-cache-dir scipy==1.10.1
RUN python -m pip install --no-cache-dir pandas==1.5.3
RUN python -m pip install --no-cache-dir scikit-learn==1.2.2
RUN python -m pip install --no-cache-dir Pillow==10.0.1
RUN python -m pip install --no-cache-dir --force-reinstall --no-deps matplotlib==3.8.4

# SymPy e dependências auxiliares
RUN python -m pip install --no-cache-dir \
    PyYAML==6.0.1 \
    python-dateutil==2.8.2 \
    pytz==2023.3 \
    joblib==1.4.2 \
    threadpoolctl==3.5.0 \
    tqdm==4.66.5

# CEEMDAN - PyEMD
RUN python -m pip install \
    EMD-signal==1.5.2 \
    pathos==0.3.2

# Hilbert-Huang Transform
RUN python -m pip install emd==0.7.0

# Empirical Wavelet Transform
RUN python -m pip install ewtpy==0.2

RUN python -c "import os, sys; print('sys.prefix:', sys.prefix); print('sys.exec_prefix:', sys.exec_prefix); print('abspath:', os.path.abspath('/usr/local/lib/python3.10/site-packages')); print('commonprefix:', os.path.commonprefix(['/usr/local/lib/python3.10/site-packages', '/tmp']))"

RUN echo "=== PYTHON ===" && \
    python --version && \
    python -m pip --version && \
    echo "=== VARIAVEIS ===" && \
    env | sort | grep -E '^(PIP|PYTHON|SETUPTOOLS)' || true

RUN python -m pip config debug

# Dependências obrigatórias do PyTorch 2.2.2
RUN python -m pip install --no-cache-dir \
    filelock \
    fsspec \
    jinja2 \
    networkx \
    sympy==1.14.0 \
    typing-extensions

# Verificação de dependências
RUN pip check

# Código do projeto
COPY . .

# Verificação individual dos módulos
RUN python -c "import inspect; print('Inspect OK:', inspect.__file__)"
RUN python -c "import sympy; print('SymPy OK:', sympy.__version__)"
RUN python -c "import matplotlib; print('Matplotlib OK:', matplotlib.__version__)"
RUN python -c "import torch; print('PyTorch OK:', torch.__version__)"
RUN python -c "import numpy, scipy; print('NumPy:', numpy.__version__, 'SciPy:', scipy.__version__)"
RUN python -c "from PyEMD import CEEMDAN; print('PyEMD OK')"

# Teste isolado do KAN
RUN python -u -X faulthandler -c "\
import sys; \
sys.path.insert(0, '/app'); \
print('Importando seqkan.kan...', flush=True); \
import seqkan.kan; \
print('KAN OK:', seqkan.kan.__file__, flush=True)"

# Teste isolado do SEQKAN
RUN python -u -X faulthandler -c "\
import sys; \
sys.path.insert(0, '/app'); \
print('Importando SeqKANSeq...', flush=True); \
from seqKAN_public_main.seqKAN import SeqKANSeq; \
print('SEQKAN OK', flush=True)"

CMD ["python", "-u", "run_france_torch.py"]